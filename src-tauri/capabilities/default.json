{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Local app window; explicit web links may open in the system browser. No file or shell access.",
  "windows": ["main"],
  "permissions": ["core:default", "core:window:allow-destroy", { "identifier": "opener:allow-open-url", "allow": [{ "url": "https://*" }, { "url": "http://*" }] }]
}
