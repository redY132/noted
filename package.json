{
  "name": "noted",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/*.test.ts",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:build": "tauri build --no-bundle",
    "test:core": "cargo test --manifest-path src-tauri/Cargo.toml --no-default-features",
    "check:comparison": "tsc -p experiments/editor-comparison/tsconfig.json --noEmit",
    "bench:editor:build": "npm run check:comparison && vite build --config experiments/editor-comparison/vite.config.ts",
    "bench:editor": "vite preview --config experiments/editor-comparison/vite.config.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-opener": "2.7.2",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/extension-list": "^3.32.0",
    "@tiptap/extension-subscript": "^3.32.0",
    "@tiptap/extension-superscript": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/extension-text-style": "^3.32.0",
    "@tiptap/extension-unique-id": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "d3-force": "^3.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/d3-force": "^3.0.10",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "grapesjs": "0.23.8",
    "jsdom": "^30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
